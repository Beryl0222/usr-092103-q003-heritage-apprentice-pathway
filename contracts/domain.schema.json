{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "老字号技艺传习履历领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "APPRENTICESHIP_STARTED",
        "PRACTICE_RECORDED",
        "ASSESSMENT_SIGNED",
        "AUTHORIZATION_GRANTED",
        "PLACEMENT_VERIFIED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "apprenticeship",
        "course_revision",
        "practice_evidence",
        "work_authorization"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
